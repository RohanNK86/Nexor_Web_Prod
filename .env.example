# Nexor Super App - Environment Template
# Copy this to .env.local and fill in your keys

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay
# Find these at: Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_key_id

# Optional email delivery (Resend)
RESEND_API_KEY=your_resend_api_key
TICKET_FROM_EMAIL="Nexor <tickets@yourdomain.com>"

# Optional email delivery (Gmail SMTP - free)
SMTP_USER=nexorsuperapp@gmail.com
SMTP_PASS=your_gmail_app_password
